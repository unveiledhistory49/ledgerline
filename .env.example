# Copy to .env (or export directly). All settings use the LEDGERLINE_ prefix.
# See src/ledgerline/config.py for the full list and defaults.

# Database URL. SQLite default works out of the box; Postgres needs a driver
# (psycopg2-binary) added to pyproject dependencies first.
LEDGERLINE_DATABASE_URL=sqlite:///./ledgerline.db

# Pepper mixed into stored API-key hashes (sha256). CHANGE THIS in production.
# Rotation requires re-issuing keys: hashes cannot be recomputed without the
# original key material. See docs/RUNBOOK.md.
LEDGERLINE_API_KEY_PEPPER=change-me-to-a-long-random-string

# Outbound webhook delivery.
LEDGERLINE_WEBHOOK_TIMEOUT_SECONDS=5.0
LEDGERLINE_WEBHOOK_MAX_ATTEMPTS=8

# Pagination defaults.
LEDGERLINE_DEFAULT_PAGE_SIZE=50
LEDGERLINE_MAX_PAGE_SIZE=200
